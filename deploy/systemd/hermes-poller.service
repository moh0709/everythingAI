[Unit]
Description=Hermes GitHub polling worker
Requires=hermes-supervisor.service
After=hermes-supervisor.service network-online.target
PartOf=hermes-runtime.target
StartLimitIntervalSec=5min
StartLimitBurst=4

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/everythingAI
EnvironmentFile=-/etc/hermes/everythingai.env
ExecStart=/usr/bin/node /opt/everythingAI/scripts/task-poller.mjs --mode polling --watch
Restart=on-failure
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/everythingAI/.hermes /opt/everythingAI/REPORTS /opt/everythingAI/LOGS

[Install]
WantedBy=hermes-runtime.target
